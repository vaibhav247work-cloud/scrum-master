# -----------------------------------------------------------------------------
# Frontend Environment Configuration Template
# -----------------------------------------------------------------------------

# Backend API base URL
# Leave empty to use Vite's dev proxy (/api -> http://localhost:8080)
# In production or standalone mode, point directly to backend (e.g. http://localhost:8080)
VITE_API_BASE_URL=

# Demo / Mock Mode
# Set to 'true' to run offline with synthetic mock data
# Set to 'false' for live backend API integration
VITE_DEMO_MODE=false
