    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
