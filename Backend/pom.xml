<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.companyos</groupId>
    <artifactId>company-os-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Company OS Backend</name>
    <description>Multi-tenant Company Operating System backend modular monolith</description>

    <modules>
        <module>platform/shared-kernel</module>
        <module>platform/tenant-context</module>
        <module>platform/security-contract</module>
        <module>platform/idempotency-contract</module>
        <module>platform/feature-entitlement</module>
        <module>platform/event-contract</module>
        <module>platform/audit-observability</module>
        <module>business/tenant-management</module>
        <module>business/identity-access</module>
        <module>business/organization-workforce</module>
        <module>business/product-management</module>
        <module>business/portfolio-management</module>
        <module>business/migration-management</module>
        <module>business/demand-management</module>
        <module>business/requirements-readiness</module>
        <module>business/workflow-management</module>
        <module>business/quality-operations</module>
        <module>business/project-management</module>
        <module>business/sprint-management</module>
        <module>business/work-management</module>
        <module>business/resource-management</module>
        <module>business/time-tracking</module>
        <module>business/dependency-risk</module>
        <module>business/release-management</module>
        <module>business/reporting-control-tower</module>
        <module>business/notification-collaboration</module>
        <module>business/integration-audit</module>
        <module>business/retention-management</module>
        <module>adapters/persistence-mysql</module>
        <module>adapters/cache-redis</module>
        <module>adapters/auth-local</module>
        <module>adapters/event-delivery</module>
        <module>backend-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
