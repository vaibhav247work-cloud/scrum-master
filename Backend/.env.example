# -----------------------------------------------------------------------------
# Backend Environment Configuration Template
# -----------------------------------------------------------------------------

# Database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/company_os?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=company_os
DB_PASSWORD=change-me

# Cache & Session Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Session Settings
# Set to 'false' for local HTTP development; set to 'true' in HTTPS production environments
SESSION_COOKIE_SECURE=false
SECURITY_CONTENT_SECURITY_POLICY=default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

# Rate Limiting
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_LOGIN_IP_LIMIT=30
SECURITY_RATE_LIMIT_LOGIN_IDENTITY_LIMIT=10
SECURITY_RATE_LIMIT_LOGIN_WINDOW=PT15M
SECURITY_RATE_LIMIT_ONBOARDING_IP_LIMIT=5
SECURITY_RATE_LIMIT_ONBOARDING_WINDOW=PT1H
SECURITY_RATE_LIMIT_ACTIVATION_IP_LIMIT=10
SECURITY_RATE_LIMIT_ACTIVATION_WINDOW=PT1H
SECURITY_RATE_LIMIT_WEBHOOK_IP_LIMIT=120
SECURITY_RATE_LIMIT_WEBHOOK_WINDOW=PT1M

# Invitations & Onboarding
EXPOSE_INVITATION_TOKEN=false

# Notifications & Integrations
NOTIFICATION_SECRET_KEY=change-this-secret-key-in-production
OUTBOX_NOTIFICATION_ENABLED=true
OUTBOX_NOTIFICATION_POLL_MS=5000
OUTBOX_NOTIFICATION_METRICS_POLL_MS=30000
OUTBOX_NOTIFICATION_METRICS_INITIAL_DELAY_MS=10000

# TTL Caching & Idempotency
IDEMPOTENCY_PROCESSING_TTL=PT10M
IDEMPOTENCY_COMPLETED_TTL=PT24H
CACHE_FEATURE_ENTITLEMENTS_TTL=PT5M
